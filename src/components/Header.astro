---
import type { Dict } from '../i18n/ua';
import { BOT_URL } from '../i18n/ua';
import Icon from './Icon.astro';
const { t } = Astro.props as { t: Dict };
const home = t.lang === 'uk' ? '/' : '/en/';
---
<header class="sticky top-0 z-50 border-b border-ink/5 bg-cream/85 backdrop-blur-md">
  <div class="wrap flex h-16 items-center justify-between gap-3">
    <a href={home} class="font-serif text-2xl font-bold tracking-tight">Mark<span class="text-accent">.</span></a>
    <nav class="hidden items-center gap-7 text-sm font-medium text-muted md:flex">
      <a href="#audience" class="hover:text-ink">{t.nav.audience}</a>
      <a href="#inside" class="hover:text-ink">{t.nav.inside}</a>
      <a href="#pricing" class="hover:text-ink">{t.nav.pricing}</a>
      <a href="#faq" class="hover:text-ink">{t.nav.faq}</a>
    </nav>
    <div class="flex items-center gap-2">
      <div class="flex rounded-full border border-ink/15 p-0.5 text-xs font-semibold" role="group" aria-label="Language">
        <a href="/" class:list={['rounded-full px-2.5 py-1.5', t.lang === 'uk' ? 'bg-ink text-cream' : 'text-muted hover:text-ink']} hreflang="uk" aria-current={t.lang === 'uk' ? 'page' : undefined}>UA</a>
        <a href="/en/" class:list={['rounded-full px-2.5 py-1.5', t.lang === 'en' ? 'bg-ink text-cream' : 'text-muted hover:text-ink']} hreflang="en" aria-current={t.lang === 'en' ? 'page' : undefined}>EN</a>
      </div>
      <a href={BOT_URL} target="_blank" rel="noopener" class="hidden items-center gap-1.5 rounded-full bg-ink px-4 py-2 text-sm font-semibold text-cream transition hover:bg-accent sm:inline-flex">
        {t.nav.cta}<Icon name="arrow" class="size-4" />
      </a>
    </div>
  </div>
</header>
