---
import type { Dict } from '../i18n/ua';
import { BOT_URL } from '../i18n/ua';
import Icon from './Icon.astro';
import MarkAvatar from './MarkAvatar.astro';
const { t } = Astro.props as { t: Dict };
const h = t.hero;
---
<section class="relative overflow-hidden">
  <div class="wrap grid items-center gap-14 pt-10 pb-10 sm:pt-16 lg:grid-cols-[1.15fr_1fr] lg:pb-0">
    <div>
      <span class="inline-flex items-center gap-2 rounded-full border border-ink/15 bg-paper px-3 py-1.5 text-xs font-semibold">
        <span class="size-2 rounded-full bg-accent"></span>{h.badge}
      </span>
      <h1 class="mt-6 font-serif text-[2.6rem] leading-[1.04] font-semibold tracking-tight text-balance sm:text-6xl lg:text-7xl">
        {h.title1}{' '}
        <span class="scribble text-accent italic">{h.title2}<svg viewBox="0 0 200 20" preserveAspectRatio="none" aria-hidden="true"><path d="M3 14C40 6 90 4 197 9" fill="none" stroke="#f4c34a" stroke-width="7" stroke-linecap="round" /></svg></span>
        <span class="mt-1 block text-ink/60">{h.title3}</span>
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">{h.lead}</p>
      <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center">
        <a href={BOT_URL} target="_blank" rel="noopener" class="btn-primary text-lg">
          <Icon name="tg" class="size-5" />{h.cta}
        </a>
        <span class="text-center text-sm font-medium text-muted sm:text-left">{h.price}</span>
      </div>
      <dl class="mt-10 grid max-w-lg grid-cols-3 gap-4 border-t border-ink/10 pt-6">
        {h.stats.map((s) => (
          <div class="flex flex-col-reverse justify-end">
            <dt class="mt-1 text-xs leading-snug text-muted sm:text-sm">{s.l}</dt>
            <dd class="font-serif text-3xl font-semibold">{s.n}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="relative mx-auto w-full max-w-[19rem] sm:max-w-sm lg:max-w-md">
      <div class="absolute inset-6 rotate-6 rounded-[2.5rem] bg-sage/50" aria-hidden="true"></div>
      <div class="relative rounded-[2.5rem] border border-ink/10 bg-paper p-7 shadow-[0_30px_60px_-30px_rgba(31,26,23,.35)] sm:p-8">
        <MarkAvatar class="mx-auto w-full max-w-[240px]" />
        <div class="mt-6 flex items-center justify-between gap-3">
          <div>
            <p class="font-serif text-xl font-semibold">{t.author.name}</p>
            <p class="text-sm text-muted">{t.author.role}</p>
          </div>
          <span class="inline-flex shrink-0 items-center gap-1.5 rounded-full bg-accent/10 px-3 py-1 text-xs font-semibold text-accent">
            <span class="size-1.5 animate-pulse rounded-full bg-accent"></span>Live · Sun
          </span>
        </div>
      </div>
      <span class="float absolute -top-4 -left-2 rounded-2xl bg-sun px-4 py-2 font-serif text-base font-semibold italic shadow-md sm:-left-8" style="--r:-6deg" aria-hidden="true">{h.stickers[0]}</span>
      <span class="float absolute top-[42%] -right-3 rounded-2xl bg-ink px-4 py-2 font-serif text-base italic text-cream shadow-md sm:-right-10" style="--r:5deg;animation-delay:-2s" aria-hidden="true">{h.stickers[1]}</span>
      <span class="float absolute -bottom-5 left-4 rounded-2xl bg-sky px-4 py-2 font-serif text-base font-semibold italic shadow-md" style="--r:-3deg;animation-delay:-3.5s" aria-hidden="true">{h.stickers[2]}</span>
    </div>
  </div>
</section>
