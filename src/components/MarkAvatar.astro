---
// Вигаданий Марк: стилізована векторна ілюстрація, не фото реальної людини
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
const clip = 'mark-clip-' + Math.random().toString(36).slice(2, 8);
---
<svg class={cls} viewBox="0 0 320 320" role="img" aria-label="Mark — illustration">
